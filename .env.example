# Copy this file to .env and fill in secrets before running
# `docker compose up`. See ARCHITECTURE.md §10.

# Host port the app is reachable on (the app always listens on 3000
# inside the container; this only changes which port that is mapped to
# on your machine).
PORT=3000

# Postgres password for the db service and the app's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Session cookie signing secret. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change-me

# The URL the app is reached at by users (used in links, e.g. in emails).
PUBLIC_URL=http://localhost:3000

# Whether new accounts can sign themselves up (false = admin-created only).
ALLOW_SIGNUP=true

# Largest file upload accepted, in megabytes.
MAX_UPLOAD_MB=25

# AI features: "anthropic" | "stub" | "off". Leave unset to auto-detect
# (anthropic when ANTHROPIC_API_KEY is set, otherwise off).
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
