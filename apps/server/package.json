{
  "name": "@stillwater/server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:ai": "vitest run test/ai",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@stillwater/editor-schema": "^0.1.0",
    "@stillwater/shared": "^0.1.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "fractional-indexing": "^3.4.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "embedded-postgres": "^16.15.0-beta.19",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
